*.patch

# VS Code settings
.vscode/

# Python cache files
__pycache__/
*.egg-info/
.pytest_cache/

# Build artifacts (python -m build, used by .github/workflows/release.yml)
dist/
build/

# Virtual environments
.venv/
venv/

# Environment files
.env
.env.*
!.env.example

# Runtime data (NFR7 — never accumulate on disk unbounded; this is a local
# dev-time backstop, not the actual retention mechanism)
data/

# Phase 17 (docs/plan.md): per-day CLI log files, logs/log_YYYY_MM_DD.log
# — the 3-day retention sweep at startup is the real mechanism, this is
# just a dev-time backstop against them ending up in a commit.
logs/

# Claude-specific files
.claude/*
claude/*

# Data folder for local development (NFR7 — never accumulate on disk unbounded; this is a local
data/

# Cache for local development (NFR7 — never accumulate on disk unbounded; this is a local
cache/
# pytest-cov (Phase 19)
.coverage
htmlcov/
