# Copy this file to .env and adjust as needed.
# See README.md "Configuration" and docs/design.md for what each value controls.

# --- Session ---
VIVA_DURATION_MINUTES=30
MAX_QUESTIONS=8
MAX_FOLLOWUP_DEPTH=1
SESSION_RETENTION_DAYS=7

# --- Ingestion / Sampling ---
MAX_FILES=500
TEST_FILE_QUOTA_PCT=10
GITHUB_TOKEN=

# --- Analysis (map-reduce Project Profile, docs/design.md §3.1) ---
MAP_REDUCE_BATCH_SIZE=8
# Left unset by default: computed as a fraction of LLM_MODEL's context
# window at runtime rather than hardcoded (docs/system-design/06-cli-contract-and-profile-scaling.md §6.2).
MAX_REDUCE_CONTEXT_TOKENS=
# Line-window fallback for files outside the tree-sitter language
# allowlist, or that fail to parse (05-repo-lifecycle-and-language-coverage.md §5.1).
LINE_WINDOW_SIZE=60
LINE_WINDOW_OVERLAP=15

# --- RAG ---
VECTOR_DB_PATH=./data/chroma
TOP_K_RETRIEVAL=5

# --- Session persistence / loop (Phase 6, docs/design.md §8) ---
SESSION_DB_PATH=./data/viva.db
# Used by the time-budget collapse check (docs/design.md §7): if
# remaining_time / avg_time_per_remaining_category is too tight, the
# session collapses to one question per remaining category rather than
# risking running out of time mid-coverage.
AVG_TIME_PER_CATEGORY_SECONDS=180

# --- LLM / Embeddings (Ollama) ---
# Default chosen via pressure-test evidence, not guessed: see
# docs/system-design/07-llm-model-pressure-test-results.md. gemma4:e4b was
# the only candidate among 7 tested that showed real signal on
# partial-correctness detection instead of defaulting to "correct", with
# the best corrected accuracy (90%) and zero call errors.
LLM_MODEL=gemma4:e4b
EMBEDDING_MODEL=nomic-embed-text
TEMPERATURE=0.3

# --- Ollama connection (Phase 0 addition — not yet in README table) ---
# Base URL of the local Ollama server. Override for a non-default host/port.
OLLAMA_HOST=http://localhost:11434
